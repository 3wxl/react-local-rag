# MCP Server 镜像（stdio 之外提供 Streamable HTTP，供离线环境内的 Cursor/其他客户端接入）。
#
# 只读备份 JSON：不连数据库、不写盘（审计除外）。模型权重运行时挂载到 /app/public/models。
FROM node:22-bookworm-slim

WORKDIR /app
COPY apps/web/package.json apps/web/package-lock.json ./
# tsx 在 devDependencies，MCP server 靠它运行 TS，必须包含 dev 依赖
RUN npm ci --include=dev

COPY apps/web/src ./src
COPY apps/web/scripts ./scripts
COPY apps/web/tsconfig.json apps/web/tsconfig.scripts.json ./
RUN mkdir -p public/models

ENV RAG_BACKUP_PATH=/data/rag-backup.json \
    RAG_MCP_ACL_PATH=/data/mcp-acl.json \
    RAG_MCP_HTTP_PORT=7331

EXPOSE 7331
# stdio 模式：docker run -i --rm ... node --import tsx scripts/mcp/server.ts
CMD ["node", "--import", "tsx", "scripts/mcp/server.ts", "--http-port", "7331", "--http-host", "0.0.0.0"]
