{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    /* 需要 DOM：脚本会 import src/ 的模块（如 verifyAnswer → embeddingClient → db），
       那些模块本身用 DOM 类型（IDBDatabase / Worker 等）。
       运行时不会真的碰 DOM —— 这里只为让类型检查通过。 */
    "lib": ["ES2023", "DOM"],
    /* vite/client 提供 `?worker` 这类 Vite 专有导入的类型声明：
       src 里的模块（embeddingClient）用了它，脚本 import src 时会一并被检查到 */
    "types": ["node", "vite/client"],
    "skipLibCheck": true,

    /* scripts 由 tsx 运行（bundler 式解析），因此按 bundler 解析类型：
       评测脚本直接 import src/ 的纯函数模块，与线上共用同一份实现 */
    "module": "esnext",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["scripts/**/*.ts"]
}
